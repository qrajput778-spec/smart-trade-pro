rules_version = '2';

// Firestore security rules for SMART TRADE PRO.
//
// Schema verified directly against the app code (src/lib/trading.ts,
// src/lib/account.ts, src/lib/admin.ts, src/lib/supportChat.ts,
// src/pages/Signup.tsx, src/pages/admin/*.tsx) as of this version:
//
//   users/{uid}                          — profile + balance + holdings +
//                                           shorts + totalRealizedPnl +
//                                           watchlist + isAdmin. `shorts` is
//                                           the same shape as `holdings` but
//                                           for open simulated short
//                                           positions — fully independent,
//                                           never touched by a Buy/Sell of
//                                           `holdings`. Created once on
//                                           signup (setDoc), then updated by
//                                           Buy/Sell/Short/Cover/Reset/
//                                           profile-save (owner — see the
//                                           update rule below), or by the
//                                           admin "Adjust Virtual Balance"
//                                           tool / deposit-withdrawal
//                                           approval (admin, `balance` and
//                                           `pendingWithdrawalTotal` only),
//                                           and deleted either during the
//                                           owner's own account deletion
//                                           (Settings, src/lib/account.ts)
//                                           or by an admin's "Remove User"
//                                           tool (AdminUserDetail's Danger
//                                           Zone, src/lib/admin.ts's
//                                           removeUserAccount) — the latter
//                                           can never target another admin
//                                           account. Either path also wipes
//                                           this uid's transactions,
//                                           portfolioSnapshots, timedTrades,
//                                           and supportChat subcollections
//                                           (see each below); it does NOT
//                                           and CANNOT delete the target's
//                                           Firebase Authentication
//                                           credentials — that requires the
//                                           Admin SDK on a trusted server,
//                                           which this project has no
//                                           backend for. NOTE: the
//                                           admin's global Trade Outcome
//                                           Control mode (systemSettings/
//                                           tradeOutcomeControl, below)
//                                           never touches this document
//                                           directly — it only ever
//                                           influences the PRICE a user's
//                                           own Sell/Cover transaction (see
//                                           the transactions schema entry)
//                                           settles at.
//   users/{uid}.isAdmin                  — boolean, absent/false by default.
//                                           No client code ever writes this
//                                           field (not even the admin-update
//                                           path above, which is restricted
//                                           to `balance` only) — it's only
//                                           ever set by hand in the Firestore
//                                           console for a specific account.
//   users/{uid}/transactions/{id}        — one doc per executed Buy/Sell,
//                                           written by the OWNER, with an
//                                           auto-generated id inside the
//                                           same transaction as their own
//                                           balance/holdings (or shorts)
//                                           update (src/lib/trading.ts).
//                                           `positionType` ('LONG'/'SHORT',
//                                           absent = 'LONG') says which of
//                                           holdings/shorts a doc affects —
//                                           see the type comment in
//                                           src/types/index.ts. Documents
//                                           are immutable forever once
//                                           created (no update path exists
//                                           for anyone, admins included).
//                                           A CLOSING record (one that
//                                           carries `realizedPnl` — a Sell
//                                           of a LONG or a Cover of a
//                                           SHORT) is priced at settlement
//                                           time according to the admin's
//                                           global Trade Outcome Control
//                                           mode (systemSettings/
//                                           tradeOutcomeControl below):
//                                           while that mode is NORMAL (or
//                                           unset) the real live market
//                                           price is used; while
//                                           FORCE_WIN/FORCE_LOSS, the price
//                                           is a guaranteed-outcome one
//                                           derived from the position's own
//                                           entry price, and the record is
//                                           additionally flagged
//                                           (adminControlled/adminAction/
//                                           adminActionBy/adminActionAt/
//                                           forcedResult) — a SIMULATED
//                                           override for a course project.
//                                           respectsGlobalOutcomeMode()
//                                           below is the rules-side
//                                           backstop making sure a
//                                           closing record's `realizedPnl`
//                                           sign actually matches whatever
//                                           mode was active, so a client
//                                           can't silently ignore it. Read
//                                           by the owner (Wallet), by an
//                                           admin viewing one account
//                                           (AdminUserDetail, direct path),
//                                           and by an admin across all
//                                           accounts (AdminDashboard/
//                                           AdminTrades, collectionGroup).
//                                           Bulk-deleted during the owner's
//                                           own account deletion, or by an
//                                           admin's "Remove User" tool
//                                           (never against another admin).
//   users/{uid}/timedTrades/{id}          — one timed/binary-style contract
//                                           (src/lib/timedTrading.ts) — a
//                                           DIFFERENT product from the
//                                           pooled holdings/shorts above:
//                                           each is its own document,
//                                           reserving `investedAmount` from
//                                           cash at OPEN and releasing it
//                                           (plus/minus P&L) at CLOSED,
//                                           never touching holdings/shorts.
//                                           Owner-created and owner-settled
//                                           (their own client's background
//                                           sweep, not an admin), exactly
//                                           once: the update rule only
//                                           allows OPEN->CLOSED, only after
//                                           `request.time` (the REAL server
//                                           time, never the client's) has
//                                           reached `openedAt` (a
//                                           serverTimestamp() the server
//                                           itself resolved) plus
//                                           `durationSeconds` — nothing
//                                           client-clock-derived is ever
//                                           trusted for the deadline itself.
//                                           `scheduledCloseAt` is stored too,
//                                           but only for the countdown UI's
//                                           convenience. Settlement also
//                                           writes a matching leg into
//                                           transactions/ above (tagged
//                                           tradeMode: 'TIMED'), so existing
//                                           admin/history views show timed
//                                           trades with no changes needed. A
//                                           WIN's profit is a tiered
//                                           percentage of investedAmount
//                                           (src/lib/trading.ts's
//                                           getProfitRateByInvestment/
//                                           calculateTieredProfit) — 5% to
//                                           13% depending on the amount
//                                           invested, NOT a flat 100% — and
//                                           settlement additionally stamps
//                                           `profitRate`/`profitPercentage`/
//                                           `profitAmount` (WIN only; absent
//                                           on a LOSS, which still simply
//                                           forfeits the full
//                                           `investedAmount`, unaffected by
//                                           the tier table).
//                                           Read by owner or admin.
//                                           Bulk-deleted during the owner's
//                                           own account deletion, or by an
//                                           admin's "Remove User" tool.
//   users/{uid}/portfolioSnapshots/{id}  — same lifecycle as transactions:
//                                           owner-created once per trade,
//                                           read by owner or admin, deleted
//                                           on the owner's own account
//                                           deletion or by an admin's
//                                           "Remove User" tool. Never updated.
//   users/{uid}/supportChat/thread       — fixed-id doc (one thread per
//                                           user) holding denormalized
//                                           lastMessage/lastMessageAt/
//                                           lastSenderRole, updated by
//                                           src/lib/supportChat.ts on every
//                                           send — by the owner (their own
//                                           messages) or by an admin
//                                           (replies, and the 7-day
//                                           stale-thread cleanup sweep).
//                                           `autoReplySent` (bool, absent on
//                                           every thread older than this
//                                           field) is written, still by the
//                                           owner, the one time a brand-new
//                                           thread's first message triggers
//                                           the automatic acknowledgment —
//                                           see sendSupportAutoReplyIfNeeded
//                                           there; no rule change was needed
//                                           for it, the owner already had
//                                           unrestricted write access here.
//   .../supportChat/thread/messages/{id} — one real chat message, PLUS
//                                           exactly one automatic message
//                                           per thread (senderRole
//                                           'system', written by the owner
//                                           as part of the transaction
//                                           above — never by an admin, and
//                                           never more than once per
//                                           thread). Read live via
//                                           onSnapshot by Support.tsx (the
//                                           owner) and AdminSupport.tsx (any
//                                           admin).
//   balanceRequests/{id}                 — top-level collection (NOT nested
//                                           under users/{uid}, so an admin's
//                                           "every request across every
//                                           user" view is a plain
//                                           collection read, no
//                                           collection-group index needed).
//                                           One doc per deposit/withdrawal
//                                           request (src/lib/
//                                           balanceRequests.ts). Created by
//                                           the owner only, always starting
//                                           'pending' with no reviewer
//                                           fields set. Only an admin can
//                                           ever move it to 'approved'/
//                                           'rejected', and only that exact
//                                           transition — userId/type/amount/
//                                           createdAt can never change after
//                                           creation. The balance change an
//                                           approval authorizes happens as a
//                                           separate write to users/{uid} in
//                                           the same client transaction, not
//                                           through this document at all.
//   users/{uid}.pendingWithdrawalTotal   — running total of a user's own
//                                           currently-pending withdrawal
//                                           request amounts. NOT a second
//                                           balance field — just a
//                                           reservation so multiple pending
//                                           withdrawal requests can never
//                                           collectively ask for more than
//                                           `balance` actually holds.
//                                           Written by the owner (submitting
//                                           a request reserves it) and by an
//                                           admin (approving/rejecting one
//                                           releases it) — see the
//                                           users/{uid} update rule below
//                                           for the exact admin-side limits.
//   kycSubmissions/{id}                   — top-level collection (NOT
//                                           nested under users/{uid}, same
//                                           reasoning as balanceRequests),
//                                           one doc per KYC verification
//                                           attempt (src/lib/kyc.ts). A
//                                           SIMULATED identity-verification
//                                           workflow for a course project —
//                                           nothing is checked against a
//                                           real identity; an admin just
//                                           reviews the uploaded files.
//                                           Created by the owner only,
//                                           always starting 'pending' with
//                                           no reviewer fields set.
//                                           Resubmitting after a rejection
//                                           creates a NEW doc (history is
//                                           just every doc for that
//                                           userId), so owners never get
//                                           update access at all — only an
//                                           admin can ever move a
//                                           submission off 'pending', and
//                                           only that exact transition.
//                                           The actual files live in a
//                                           private Supabase Storage bucket
//                                           (kyc-documents) at
//                                           kyc/{uid}/{submissionId}/{docType}.{ext}
//                                           — see SUPABASE_STORAGE_SETUP.md.
//                                           Firestore only stores each
//                                           file's path, never a download
//                                           URL (see KycDocumentInfo in
//                                           src/types/index.ts) and never
//                                           the file itself.
//   systemSettings/tradeOutcomeControl    — a SINGLETON document (one doc
//                                           total, not one per admin) at
//                                           this exact path holding
//                                           { mode: 'NORMAL'|'FORCE_WIN'|
//                                           'FORCE_LOSS', updatedBy,
//                                           updatedByEmail, updatedAt }.
//                                           Written only by an admin (the
//                                           Trade Outcome Control page,
//                                           src/lib/admin.ts's
//                                           setGlobalTradeOutcomeMode) via a
//                                           full setDoc overwrite. Read by
//                                           every signed-in user, because
//                                           every user's own Sell/Cover
//                                           transaction (src/lib/
//                                           trading.ts) needs to read this
//                                           mode at settlement time to
//                                           price its own trade correctly —
//                                           see the transactions schema
//                                           entry above.
//   adminActions/{id}                    — accountability log for admin
//                                           actions: the balance-adjust
//                                           tool, and deposit/withdrawal
//                                           approve/reject decisions (each
//                                           one addDoc'd in the same
//                                           transaction as the decision
//                                           itself). Create-only — no
//                                           screen in the app reads this
//                                           back yet, so no client gets read
//                                           access either (see the rule
//                                           below for how to relax this if
//                                           an admin-activity viewer is ever
//                                           built).
//   supportMessages/{id}                 — the OLD static contact-form
//                                           collection. No longer written by
//                                           any current code (Support.tsx
//                                           was replaced by the live
//                                           supportChat above) — rule kept
//                                           narrow and harmless in case any
//                                           historical documents remain.
//
// Everything not explicitly matched below is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True only for the specific account(s) manually flipped to isAdmin:
    // true in the Firestore console — no client code ever sets this field
    // (see users/{uid}'s update rule below, which restricts any
    // admin-initiated write to the unrelated `balance` field only), so a
    // user can't grant themselves admin access by writing their own doc.
    // The get() costs one extra document read per rules evaluation.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // True when the given uid's OWN doc has isAdmin == true — used only to
    // stop one admin from removing another admin's account via the "Remove
    // User" tool (src/lib/admin.ts's removeUserAccount). Distinct from
    // isAdmin() above, which always checks the CALLER's own doc; this
    // checks an arbitrary target uid instead.
    //
    // Uses map.get(key, default) rather than direct `.data.isAdmin` access:
    // a normal (non-admin) account's doc never sets `isAdmin` at all — it's
    // not just false, the field is fully ABSENT — and Firestore Rules
    // treats reading a genuinely missing map key via dot-access as an
    // evaluation error, which silently denies the whole rule rather than
    // throwing something visible. .get() with a default sidesteps that
    // entirely. (This bit an actual "Remove User" attempt against a real
    // signed-up, non-admin account — every account this was tested against
    // before that had `isAdmin` explicitly set one way or the other.)
    function isAdminAccount(targetUid) {
      return get(/databases/$(database)/documents/users/$(targetUid)).data.get('isAdmin', false) == true;
    }

    // Deposit requests are limited to the three configured UI destinations.
    // This keeps a client from claiming a different network/address pair
    // while still allowing the existing pending-review workflow unchanged.
    function hasValidDepositDestination(data) {
      return
        (data.depositNetwork == 'BNB Smart Chain (BEP20)' &&
          data.depositAddress == '0x384530e620afe8c3257d1ed531b124ce618e63a8') ||
        (data.depositNetwork == 'Tron (TRC20)' &&
          data.depositAddress == 'TEBccrzx8sXVmD6hfhtyM6uAmULwfcGqUw') ||
        (data.depositNetwork == 'Ethereum (ERC20)' &&
          data.depositAddress == '0x384530e620afe8c3257d1ed531b124ce618e63a8');
    }

    // Rules-side backstop for the admin's global Trade Outcome Control mode
    // (systemSettings/tradeOutcomeControl below): a client CREATING a
    // closing transaction record (one that carries `realizedPnl` — see the
    // transactions schema comment) must have priced it consistent with
    // whatever mode is active, so a modified/malicious client can't just
    // skip src/lib/trading.ts's own settlement-price logic and write
    // whatever outcome it wants. An OPENING record (no `realizedPnl`) is
    // never affected by the mode, so it's always allowed through here.
    // Missing document / missing field are both treated as NORMAL — the
    // documented default before an admin has ever touched the setting.
    function respectsGlobalOutcomeMode() {
      return !('realizedPnl' in request.resource.data) ||
        !exists(/databases/$(database)/documents/systemSettings/tradeOutcomeControl) ||
        !(get(/databases/$(database)/documents/systemSettings/tradeOutcomeControl).data.mode in ['FORCE_WIN', 'FORCE_LOSS']) ||
        (get(/databases/$(database)/documents/systemSettings/tradeOutcomeControl).data.mode == 'FORCE_WIN' &&
          request.resource.data.realizedPnl >= 0) ||
        (get(/databases/$(database)/documents/systemSettings/tradeOutcomeControl).data.mode == 'FORCE_LOSS' &&
          request.resource.data.realizedPnl <= 0);
    }

    // The real deadline for a timed trade (src/lib/timedTrading.ts): NOT
    // the client-supplied `scheduledCloseAt` field (kept only as a display
    // convenience for the countdown UI), but `openedAt` — a serverTimestamp()
    // sentinel that Firestore itself resolves to the true commit time — plus
    // the trade's own durationSeconds. Because `openedAt` is server-resolved
    // by the time any settlement is attempted, this deadline is immune to
    // client clock skew of any size, not just "normal" drift.
    function timedTradeDeadline(tradeData) {
      return tradeData.openedAt + duration.value(tradeData.durationSeconds, 's');
    }

    match /users/{uid} {
      // Owner: signup's initial setDoc, Buy/Sell balance+holdings updates,
      // Reset Portfolio, profile display-name save, watchlist edits, and
      // their own Settings > Delete Account flow's final deleteDoc
      // (src/lib/account.ts).
      // Admin: read access for AdminUsers/AdminUserDetail.
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Owner: their own Settings > Delete Account flow (src/lib/account.ts)
      // — the only path that ever actually deletes a users/{uid} document.
      // Admin "Remove User" (src/lib/admin.ts's removeUserAccount) does NOT
      // delete this document — see the update rule below for why — so this
      // branch exists for the owner case only; the isAdmin() half is kept
      // as a historical/defense-in-depth allowance and is not exercised by
      // any current admin tool. Never against another admin account either
      // way. Uses .get('isAdmin', false) rather than direct `.data.isAdmin`
      // access — see isAdminAccount() above for why a normal account (where
      // the field is entirely absent, not just false) needs that.
      allow delete: if isOwner(uid) || (isAdmin() && resource.data.get('isAdmin', false) != true);

      // Owner covers all of the app's own balance/holdings/shorts/profile
      // writes, including reserving/releasing their own
      // pendingWithdrawalTotal hold when they submit/have a withdrawal
      // request resolved by an admin, and opening/closing simulated short
      // positions (src/lib/trading.ts's executeShortOrder/closeShortOrder,
      // which touch `shorts`, never `holdings`) — the global Trade Outcome
      // Control mode changes what PRICE a close settles at, never who
      // performs the write, so it never needs a separate admin-write path
      // here.
      //
      // Admin gets exactly two, narrowly-fixed update shapes — nothing else:
      //
      // 1. `balance`/`pendingWithdrawalTotal` only, `balance` left a valid
      //    non-negative number — exactly (and only) what the "Adjust Virtual
      //    Balance" tool and the deposit/withdrawal approval flow
      //    (src/lib/balanceRequests.ts) do.
      // 2. The fixed "deactivate and purge" shape "Remove User"
      //    (src/lib/admin.ts's removeUserAccount) writes. This project runs
      //    on Firebase's free Spark plan with no Cloud Functions/Admin SDK
      //    available, so a client can never actually delete another user's
      //    Firebase Authentication credentials (only the Admin SDK on a
      //    trusted backend can, and there is deliberately no such backend
      //    here) — "Remove User" instead deactivates the account IN PLACE:
      //    it tombstones this document with accountStatus/accessDisabled/
      //    deletedAt/deletionReason (which AuthContext.tsx's login guard
      //    checks to sign a deactivated account back out immediately) and
      //    zeroes its trading state, rather than deleting the document —
      //    the document has to keep existing for that guard to have
      //    something to read. Restricted to exactly this field set, with
      //    the tombstone values pinned to their required shape, and never
      //    against another admin account.
      //
      // Neither branch ever lets an admin touch email, isAdmin,
      // displayName, watchlist, or any field outside what's listed above.
      allow update: if isOwner(uid) || (
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'pendingWithdrawalTotal']) &&
        request.resource.data.balance is number &&
        request.resource.data.balance >= 0 &&
        (!('pendingWithdrawalTotal' in request.resource.data) ||
          (request.resource.data.pendingWithdrawalTotal is number &&
            request.resource.data.pendingWithdrawalTotal >= 0))
      ) || (
        isAdmin() &&
        resource.data.get('isAdmin', false) != true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus', 'deletedAt', 'deletionReason', 'accessDisabled',
          'balance', 'holdings', 'shorts', 'watchlist', 'totalRealizedPnl', 'pendingWithdrawalTotal'
        ]) &&
        request.resource.data.accountStatus == 'deleted' &&
        request.resource.data.accessDisabled == true &&
        request.resource.data.balance == 0 &&
        request.resource.data.pendingWithdrawalTotal == 0
      );

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        // Every transaction is owner-created (src/lib/trading.ts) — there
        // is no separate admin-authored trade record anymore now that
        // Trade Outcome Control is a persistent mode a user's OWN
        // settlement reads, rather than an admin acting on someone else's
        // trade directly. respectsGlobalOutcomeMode() (above) is the
        // rules-side check that a closing record's realizedPnl sign
        // actually matches whatever mode was active at creation time.
        allow create: if isOwner(uid) && respectsGlobalOutcomeMode();
        // Immutable forever once created — no update path exists for
        // anyone, admins included.
        allow update: if false;
        // Reached by the owner's own account-deletion cleanup flow, and by
        // an admin's "Remove User" cleanup (src/lib/admin.ts's
        // removeUserAccount) — never against another admin's account.
        allow delete: if isOwner(uid) || (isAdmin() && !isAdminAccount(uid));
      }

      // Timed/binary-style contracts (src/lib/timedTrading.ts) — a
      // DIFFERENT product from the pooled holdings/shorts above: each one
      // is its own independent document, opens OPEN, and settles itself to
      // CLOSED exactly once when its scheduled time arrives. Every
      // read/write is owner-only (settlement runs as the trader's own
      // write, triggered by their own client's background sweep — see
      // TimedTradesContext — never by an admin acting on someone else's
      // trade), with admin read access for visibility.
      match /timedTrades/{tradeId} {
        allow read: if isOwner(uid) || isAdmin();

        // A fresh OPEN trade: exactly the fields src/lib/timedTrading.ts's
        // openTimedTrade writes. `durationSeconds` is restricted to the
        // four real duration options — everything else about the schedule
        // (see timedTradeDeadline above) is derived from `openedAt`, which
        // this create call can only ever set via a serverTimestamp()
        // sentinel (Firestore resolves it to the true commit time), so
        // there's nothing client-clock-derived left to validate here.
        // `scheduledCloseAt` is stored only for the countdown UI's
        // convenience and is intentionally NOT security-checked — a wrong
        // value there could make the display's countdown inaccurate, never
        // the actual settlement gate below.
        allow create: if isOwner(uid) &&
          request.resource.data.status == 'OPEN' &&
          request.resource.data.direction in ['LONG', 'SHORT'] &&
          request.resource.data.investedAmount is number && request.resource.data.investedAmount > 0 &&
          request.resource.data.entryPrice is number && request.resource.data.entryPrice > 0 &&
          request.resource.data.quantity is number && request.resource.data.quantity > 0 &&
          request.resource.data.durationSeconds in [60, 300, 900, 3600] &&
          request.resource.data.scheduledCloseAt is timestamp;

        // Settlement: OPEN -> CLOSED exactly once, and only once
        // `request.time` (the REAL server time, never the client's) has
        // actually reached this trade's own server-resolved deadline. This
        // is what makes settleTimedTradeIfDue's duplicate-safety
        // (re-reading `status` fresh inside its own transaction) also hold
        // up against a client that tries to skip straight to calling this
        // update rule itself, or one whose local clock is arbitrarily wrong.
        allow update: if isOwner(uid) &&
          resource.data.status == 'OPEN' &&
          request.resource.data.status == 'CLOSED' &&
          request.time >= timedTradeDeadline(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'exitPrice', 'closedAt', 'result', 'realizedPnl', 'returnAmount', 'profitRate', 'profitPercentage', 'profitAmount', 'adminControlled', 'adminAction', 'adminActionBy', 'forcedResult']);

        // Reached by the owner's own account-deletion cleanup flow, and by
        // an admin's "Remove User" cleanup — never against another admin's
        // account.
        allow delete: if isOwner(uid) || (isAdmin() && !isAdminAccount(uid));
      }

      match /portfolioSnapshots/{snapshotId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update: if false;
        // Reached by the owner's own account-deletion cleanup flow, and by
        // an admin's "Remove User" cleanup — never against another admin's
        // account.
        allow delete: if isOwner(uid) || (isAdmin() && !isAdminAccount(uid));
      }

      // Real user↔admin support chat (src/lib/supportChat.ts). A user can
      // read/write only their own thread; an admin can read/write any
      // thread (to reply, and to run the 7-day stale-thread cleanup).
      match /supportChat/{threadId} {
        allow read, write: if isOwner(uid) || isAdmin();

        match /messages/{messageId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }
    }

    // Deposit/withdrawal REQUEST workflow (src/lib/balanceRequests.ts).
    // Top-level collection (not nested under users/{uid}) so an admin's
    // "every request across every user" queries in AdminDeposits.tsx /
    // AdminWithdrawals.tsx are a plain collection read — no collection-group
    // index required. Submitting a request never changes balance by itself;
    // status starts 'pending' and stays that way until an admin moves it to
    // 'approved' or 'rejected' (see users/{uid}'s update rule above for
    // exactly how that admin review is allowed to touch
    // balance/pendingWithdrawalTotal, and only in that exact shape).
    match /balanceRequests/{requestId} {
      // A user can only ever file a request for themselves, in a fresh
      // 'pending' state with no reviewer fields set — they can't forge an
      // already-approved request, credit/debit someone else's account, or
      // claim a reviewer identity. Deposit requests bind userEmail to the
      // signed-in Firebase Auth account; that remains correct even for a
      // legacy profile document whose email field is missing or stale.
      // Withdrawal requests keep the existing profile-email check.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        ((request.resource.data.type == 'deposit' &&
            request.resource.data.userEmail == request.auth.token.email) ||
          (request.resource.data.type == 'withdrawal' &&
            request.resource.data.userEmail ==
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email)) &&
        request.resource.data.type in ['deposit', 'withdrawal'] &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null &&
        (request.resource.data.type == 'withdrawal' ||
          hasValidDepositDestination(request.resource.data));

      // Owner can read/list only their own requests (Wallet's request
      // history); an admin can read/list every request.
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Only an admin can move a request off 'pending', and only to
      // 'approved'/'rejected' — never touching userId/userEmail/type/
      // amount/createdAt, and always stamping their own uid as reviewer
      // (never someone else's). The actual balance change this authorizes
      // happens as a separate write to users/{uid} in the very same client
      // transaction — see src/lib/balanceRequests.ts.
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'adminNote']) &&
        request.resource.data.reviewedBy == request.auth.uid;

      // Normally permanent — nobody deletes a request, including the owner
      // or an admin acting day-to-day. The one deliberate exception: an
      // admin's "Remove User" full account deletion (src/lib/admin.ts's
      // removeUserAccount) is a genuine, explicit right-to-erasure-style
      // wipe of everything that account owns, so it needs to remove this
      // user's own past requests too — but never another admin's, same
      // protection every other admin-initiated delete in this file uses.
      allow delete: if isAdmin() && !isAdminAccount(resource.data.userId);
    }

    // KYC verification workflow (src/lib/kyc.ts) — a SIMULATED identity
    // check for a course project; see the schema comment above. Top-level
    // collection so an admin's "every submission across every user" query
    // in AdminKyc.tsx is a plain collection read — no collection-group
    // index required.
    match /kycSubmissions/{submissionId} {
      // A user can only ever file a submission for themselves, in a fresh
      // 'pending' state with no reviewer fields set — they can't forge an
      // already-verified submission or claim a reviewer identity.
      // userEmail must match their own profile, same integrity check as
      // balanceRequests' create rule.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.rejectionReason == null;

      // Owner can read/list only their own submissions (their KYC history);
      // an admin can read/list every submission.
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Owners never get update access at all — resubmitting after a
      // rejection creates a brand-new document (see the schema comment),
      // so there is nothing for an owner to legitimately update on an
      // existing one. Only an admin can move a submission off 'pending',
      // and only to 'verified'/'rejected', touching nothing but the
      // review fields, and always stamping their own uid as reviewer.
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['verified', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason', 'updatedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid;

      // Normally permanent — nobody deletes a submission day-to-day, owner
      // or admin. The one deliberate exception, same as balanceRequests
      // above: an admin's "Remove User" full account deletion needs to
      // remove this user's own KYC history (and the private Supabase files
      // it points to — see src/lib/admin.ts) as part of a genuine complete
      // wipe, never another admin's.
      allow delete: if isAdmin() && !isAdminAccount(resource.data.userId);
    }

    // Collection-group read for the admin dashboard/trade feed
    // (collectionGroup('transactions') in AdminDashboard.tsx / AdminTrades.tsx).
    // Firestore requires a separate top-level `{path=**}` wildcard match for
    // collection-group queries — the nested match above only covers direct
    // users/{uid}/transactions/{id} path reads, not cross-user queries.
    // NOTE: collectionGroup() queries with an orderBy also require a
    // collection-group index on that field, configured separately in the
    // Firebase console (Firestore → Indexes) — this rule alone doesn't
    // create it.
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    // Collection-group read for AdminSupport.tsx's thread list
    // (collectionGroup('supportChat'), ordered by lastMessageAt). Same
    // requirement as above: a top-level wildcard match, plus a
    // collection-group index on "lastMessageAt" set up separately in the
    // Firebase console.
    match /{path=**}/supportChat/{threadId} {
      allow read: if isAdmin();
    }

    // Global Trade Outcome Control — one singleton document
    // (systemSettings/tradeOutcomeControl) read by EVERY signed-in user's
    // own trade-settlement code (src/lib/trading.ts) to price a closing
    // trade, and written only by an admin from the Trade Outcome Control
    // page (src/lib/admin.ts's setGlobalTradeOutcomeMode). Read access is
    // deliberately broad (any signed-in user, not just admins) because
    // that settlement logic runs as the OWNER's own write, not through any
    // admin-privileged path — see respectsGlobalOutcomeMode() above for
    // how the mode is still enforced even if a client tried to ignore it.
    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        settingId == 'tradeOutcomeControl' &&
        request.resource.data.mode in ['NORMAL', 'FORCE_WIN', 'FORCE_LOSS'] &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /adminActions/{actionId} {
      // Accountability log for src/lib/admin.ts's balance-adjust tool.
      // adminUid must match the caller — an admin can't file a record
      // claiming a different admin made the change.
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      // No screen reads this back yet — change to `if isAdmin();` if an
      // admin-activity viewer is ever built.
      allow read: if false;
      allow update, delete: if false;
    }

    // One doc per "Remove User" run, keyed by the TARGET's own uid (see
    // src/lib/admin.ts's removeUserAccount) — a minimal, dedicated audit
    // trail for the Spark-plan "deactivate and purge" flow, separate from
    // the general adminActions log above. Deliberately holds only uid/email
    // snapshot/adminUid/reason/timestamp/status — never KYC document
    // content or anything else sensitive. adminUid must match the caller,
    // same accountability rule as adminActions. `update` (not just
    // `create`) is allowed because a retried run after a partial failure
    // overwrites the same doc id rather than creating a second one.
    match /deletionAudit/{targetUid} {
      allow create, update: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow read: if false;
      allow delete: if false;
    }

    match /supportMessages/{messageId} {
      // No longer written by any current code — kept narrow and harmless
      // in case any historical documents remain from before the live chat
      // replaced this. If something ever needs to read these back, change
      // `allow read` accordingly.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
