# Firebase project config — fill these in from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration)
# This is a UNIVERSITY COURSE PROJECT / paper-trading simulator.
# No real funds, wallets, or KYC data are ever collected — see README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase project config — file storage ONLY (KYC documents, support chat
# image attachments). Firebase Auth/Firestore/Hosting are unaffected; this
# replaces Firebase Storage, which was abandoned because Google Cloud
# billing activation repeatedly failed (OR_BACR2_31 / OR_BACR2_59) — see
# SUPABASE_STORAGE_SETUP.md for full setup steps.
#
# VITE_SUPABASE_ANON_KEY is the PUBLISHABLE ("anon") key from
# Project Settings > API in the Supabase dashboard — never the secret/
# service-role key, which must never appear in frontend code or this file.

VITE_SUPABASE_URL=https://kekpnymidldayqtgapvd.supabase.co
VITE_SUPABASE_ANON_KEY=
